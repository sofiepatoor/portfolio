---
import Card from '../components/Card.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;

const dateFormatOptions = {
  year: "numeric",
  month: "short",
  day: "numeric",
};
---
<BaseLayout pageTitle={frontmatter.title}>
  <div class="container">
    <h1>{frontmatter.title}</h1>
    <p class="short-description">{frontmatter.short_description}</p>
    <time class="date caption">{frontmatter.created_date.toLocaleDateString('en-GB', dateFormatOptions)}</time>
    <Card>
      <div class="content">
        <slot />
      </div>
    </Card>
  </div>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
    margin-bottom: 0.2em;
  }

  .short-description {
    font-size: 1.25rem;
  }

  .date {
    display: block;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
</style>