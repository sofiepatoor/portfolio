---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PostList from '../components/PostList.astro';

---

<BaseLayout pageTitle="home">
  <section class="hero">
    <div class="container">
      <h1>Sofie Patoor</h1>
      <div>
        <p>
          I'm a medior <strong>front-end developer</strong> with a creative background, based in Ghent. I care about thoughtful design, accessibility and high-quality code.
        </p>
        <Button href="https://www.linkedin.com/in/sofiepatoor/" alignment={'center'}>
          Say hi!
        </Button>
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <Card title="blog">
        <PostList />
      </Card>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    font-size: 4rem;
    text-align: center;
  }

  .hero {
    min-height: 40vh;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 2rem;

    p {
      font-size: 1.25rem;
      text-align: center;
      margin: 0 auto 2rem;
      max-width: 50ch;
    }
  }
</style>
