---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';

---

<BaseLayout pageTitle="home">
  <section class="hero">
    <div class="container">
      <h1>Sofie Patoor</h1>
      <div>
        <p>
          I'm a medior <strong>front-end developer</strong> with a creative background. I care about usability, accessibility and generally the craft of writing high-quality code.
        </p>
        <Button alignment={'center'}>
          Say hi!
        </Button>
      </div>
    </div>
  </section>

  <section class="current" id="current">
    <div class="container">
      <Card title="Current endeavors">
        <div class="content">
          <p>I want my personal website to reflect how I keep growing as a developer and put the concept of "learning in public" into practice.</p>
          <p>Right now, I'm focusing on:</p>
          <ul>
            <li>broadening my skillset as a developer by <strong>building personal projects</strong></li>
            <li>actively educating myself on <strong>digital accessibility</strong></li>
          </ul>
        </div>
      </Card>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    font-size: 4rem;
    text-align: center;
  }

  .hero {
    min-height: 50vh;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;

    p {
      font-size: 1.25rem;
      text-align: center;
      margin: 0 auto 2rem;
      max-width: 50ch;
    }
  }

  .hero,
  .about,
  .current {
    margin-bottom: 4rem;
  }
</style>
