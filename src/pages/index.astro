---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PostList from '../components/PostList.astro';

---

<BaseLayout pageTitle="home">
  <section class="hero">
    <div class="container">
      <h1>Sofie Patoor</h1>
      <div>
        <p>
          front-end developer &sol;&sol; hobby collector
          <br />
          Welcome to my little internet nook!
        </p>
      </div>
    </div>
  </section>

  <section class="h-feed">
    <div class="container">
      <Card title="blog">
        <div class="blog-card-inner">
          <PostList />
          <Button href="/blog">
            View all posts
          </Button>
        </div>
      </Card>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    font-size: clamp(2rem, 10vw, 4rem);
    text-align: center;
  }

  .hero {
    min-height: 40vh;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 2rem;

    p {
      font-size: clamp(1rem, 3vw, 1.25rem);
      text-align: center;
      margin: 0 auto 2rem;
      max-width: 50ch;
    }
  }

  .blog-card-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
