---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaList from "../components/MediaList.astro";
---

<BaseLayout pageTitle="library">
  <section class="h-feed">
    <div class="container">
      <h1 class="p-name">Media journal</h1>
      <p>A list of everything I've read / watched / played lately.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="caption">august 2026</h2>
      <MediaList />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }
</style>
