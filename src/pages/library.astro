---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaList from "../components/MediaList.astro";
import Button from "../components/Button.astro";

import { mediaFinished, mediaOngoing, sortMedia } from "../utils/media";

const mediaFinished2026 = mediaFinished.filter(({ data }) => {
  const finishedDate = data.date_finished;
  const limitDate = new Date("2025-12");
  return finishedDate && finishedDate > limitDate;
});
const mediaFinished2026Sorted = sortMedia(mediaFinished2026);
---

<BaseLayout pageTitle="media journal">
  <section>
    <div class="container">
      <h1>Media journal</h1>
      <p class="intro">Take a look at the things I've (mostly) been enjoying lately.</p>
      <Button href="/library/all"> View all entries</Button>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="caption">ongoing</h2>
      <MediaList mediaItems={mediaOngoing} />
      <h2 class="caption">2026</h2>
      <MediaList mediaItems={mediaFinished2026Sorted} />
      <p>This list is far from complete, I will add more entries soon!</p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }

  .intro {
    margin-bottom: var(--space-md);
  }
</style>
