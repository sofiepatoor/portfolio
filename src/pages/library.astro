---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaList from "../components/MediaList.astro";
import Button from "../components/Button.astro";

import { mediaFinished, mediaOngoing, sortMedia, groupMediaByMonth } from "../utils/media";
import Card from "../components/Card.astro";

const mediaFinishedRecently = mediaFinished.filter(({ data }) => {
  const finishedDate = data.date_finished;
  if (finishedDate === null) {
    return false;
  }
  const limitDate = new Date();
  limitDate.setMonth(limitDate.getMonth() - 2);
  return finishedDate && finishedDate > limitDate;
});
const mediaFinishedRecentlySorted = sortMedia(mediaFinishedRecently);
const mediaRecentGroups = groupMediaByMonth(mediaFinishedRecentlySorted);
const months = Object.keys(mediaRecentGroups);
---

<BaseLayout pageTitle="library">
  <section>
    <div class="container">
      <h1>Library</h1>
      <p class="intro">These pages serve as a journal for the various forms of media I have (mostly) enjoyed over the years.</p>
      <Button href="/library/all"> View full library </Button>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="caption">ongoing</h2>
      <MediaList mediaItems={mediaOngoing} />

      <hr />

      {
        months.map((month) => (
          <>
            <h2 class="caption">{month}</h2>
            <MediaList mediaItems={mediaRecentGroups[month]} />
          </>
        ))
      }

      <Button href="/library/all"> View full library </Button>
    </div>
  </section>

  <section>
    <div class="container">
      <Card>
        <h2>My favourites &lt;3</h2>
        <p>Coming soon!</p>
      </Card>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Reviews</h2>
      <p>Coming soon :)</p>
      <!-- <Button href="/library/all">All reviews</Button> -->
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }

  .intro {
    margin-bottom: var(--space-md);
  }

  hr {
    border-color: var(--purple);
    opacity: 0.5;
    margin-block: var(--space-lg);
    width: 30%;
  }
</style>
