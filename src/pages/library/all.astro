---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaList from "../../components/MediaList.astro";

import { mediaFinished, sortMedia, groupMediaByYear, groupMediaByType } from "../../utils/media";

const mediaFinishedSorted = sortMedia(mediaFinished);
const mediaGroups = groupMediaByYear(mediaFinishedSorted);
const years = Object.keys(mediaGroups).sort((a: string, b: string) => parseInt(b, 10) - parseInt(a, 10));
for (const year in mediaGroups) {
  mediaGroups[year] = groupMediaByType(mediaGroups[year]);
}
---

<BaseLayout pageTitle="my library">
  <section>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/library">media</a></li>
          <li><span aria-current="page">all</span></li>
        </ol>
      </nav>
      <h1>My library</h1>
      <p class="intro">A full overview :))</p>
      <ul class="year-links">
        {
          years.map((year) => (
            <li>
              <a href={`#${year}`} class="caption-link">
                {year}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      {
        years.map((year) => (
          <div id={year}>
            <h2>{year}</h2>
            {Object.keys(mediaGroups[year]).map((type) => (
              <div>
                <h3 class="caption">{type}</h3>
                <MediaList mediaItems={mediaGroups[year][type]} />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }

  .intro {
    margin-bottom: var(--space-md);
  }

  .year-links {
    display: flex;
    gap: var(--space-md);
    padding: 0;

    li {
      list-style: none;
    }
  }
</style>
