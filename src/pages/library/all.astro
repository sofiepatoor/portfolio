---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaList from "../../components/MediaList.astro";

import { mediaFinished, sortMedia, groupMediaByYear, groupMediaByType } from "../../utils/media";

const mediaFinishedSorted = sortMedia(mediaFinished);
const mediaGroups = groupMediaByYear(mediaFinishedSorted);
const years = Object.keys(mediaGroups).sort((a: string, b: string) => parseInt(b, 10) - parseInt(a, 10));
for (const year in mediaGroups) {
  mediaGroups[year] = groupMediaByType(mediaGroups[year]);
}
---

<BaseLayout pageTitle="full library">
  <section>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/library">library</a></li>
          <li><span aria-current="page">all</span></li>
        </ol>
      </nav>
      <h1>Full library</h1>

      <div class="search-bar">
        <label for="search-input">Search: </label>
        <input type="search" name="search" id="search-input" />
      </div>

      <ul class="year-links">
        {
          years.map((year) => (
            <li>
              <a href={`#${year}`} class="caption-link">
                {year}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      {
        years.map((year) => (
          <div id={year} class="media-group">
            <h2>{year}</h2>
            {Object.keys(mediaGroups[year]).map((type) => (
              <div class="media-group">
                <h3 class="caption">{type}</h3>
                <MediaList mediaItems={mediaGroups[year][type]} />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }

  .intro {
    margin-bottom: var(--space-md);
  }

  .year-links {
    display: flex;
    gap: var(--space-md);
    padding: 0;

    li {
      list-style: none;
    }
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);

    input {
      border: none;
      background-color: hsla(0, 0%, 100%);
      padding-inline: 0.5em;
    }
  }

  .media-group:not(:has([data-media-title]:not(.hide))) {
    display: none;
  }
</style>

<script>
  const searchInput = document.getElementById("search-input");
  const mediaItems = [...document.querySelectorAll("[data-media-title]")];

  const resetMediaItems = () => {
    mediaItems.forEach((item) => item.classList.remove("hide"));
  };

  const filterMediaItems = (query: string) => {
    mediaItems.forEach((item) => {
      const mediaTitle = item.dataset.mediaTitle || "";
      if (mediaTitle.includes(query)) {
        item.classList.remove("hide");
      } else {
        item.classList.add("hide");
      }
    });
  };

  if (searchInput && mediaItems.length > 0) {
    searchInput.addEventListener("input", (e) => {
      const searchValue = searchInput.value?.toLocaleLowerCase().trim();
      if (searchValue === "") {
        resetMediaItems();
      } else {
        filterMediaItems(searchValue);
      }
    });
  }
</script>
