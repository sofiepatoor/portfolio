---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const reviews = (await getCollection("reviews")).sort((a, b) => b.data.created_date.valueOf() - a.data.created_date.valueOf());
---

<BaseLayout>
  <section>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/library">media</a></li>
          <li><span aria-current="page">reviews</span></li>
        </ol>
      </nav>

      <h1>Reviews</h1>

      <ul>
        {
          reviews.map((review) => (
            <li>
              <a href={`reviews/${review.id}`}>{review.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }
</style>
