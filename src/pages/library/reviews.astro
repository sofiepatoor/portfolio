---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewsList from "../../components/ReviewsList.astro";

const allReviews = (await getCollection("reviews")).filter(({ data }) => data.draft !== true).sort((a, b) => b.data.date_created.valueOf() - a.data.date_created.valueOf());
---

<BaseLayout pageTitle="reviews">
  <section>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/library">library</a></li>
          <li><span aria-current="page">reviews</span></li>
        </ol>
      </nav>

      <h1>Reviews</h1>
      {allReviews.length > 0 ? <ReviewsList reviews={allReviews} /> : <p>Coming soon!</p>}
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  h1 {
    padding-top: clamp(30px, 5vh, 60px);
  }
</style>
