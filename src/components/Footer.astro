---
import HCard from "./HCard.astro";
---

<footer>
  <div class="container">
    <address>
      <HCard hideAvatar={true} />
      <a href="https://github.com/sofiepatoor" class="caption-link" target="_blank" rel="me">
        Github
        <span class="vh">(opens in new tab)</span>
      </a>
    </address>
  </div>
</footer>

<style lang="scss">
  footer {
    width: 100%;
    padding-block: 1rem;
  }

  address {
    font-style: normal;
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
  }

  p {
    text-align: center;
  }
</style>