---
import HCard from "./HCard.astro";
---

<footer>
  <div class="container">
    <div class="footer-content">
      <HCard hideAvatar={true} />
      <ul>
        <li>
          <a href="/colophon" class="caption-link">colophon</a>
        </li>
        <li>
          <a href="https://github.com/sofiepatoor" class="caption-link" target="_blank" rel="me">
            Github
            <span class="vh">(opens in new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style lang="scss">
  footer {
    width: 100%;
    padding-block: 3rem 1rem;
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);

    ul {
      display: flex;
      gap: var(--space-md);
      padding-left: 0;
    }

    li {
      list-style: none;
    }
  }
</style>
