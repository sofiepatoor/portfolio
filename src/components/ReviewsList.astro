---
import { Picture } from "astro:assets";
const { reviews } = Astro.props;

const dateFormatOptions = {
  year: "numeric",
  month: "short",
  day: "numeric",
};

import ArrowRight from "../assets/icons/arrow-right.svg";
---

<ul class="list">
  {
    reviews.map((review) => (
      <li>
        <div class="item">
          <div class="item-image-wrapper">
            <Picture class="item-image" src={review.data.image} formats={["avif", "jpg"]} alt="" layout="constrained" width={70} height={70} />
          </div>
          <div class="item-info">
            <a href={`/library/reviews/${review.id}/`} class="item-title u-url p-name">
              {review.data.title}
            </a>
            <p class="item-details caption-small">
              {review.data.type}
              <span class="divider">&sol;</span>
              {review.data.date_created.toLocaleDateString("en-GB", dateFormatOptions)}
            </p>
          </div>
          <ArrowRight class="item-icon" width={24} height={24} stroke="currentColor" />
        </div>
      </li>
    ))
  }
</ul>

<style lang="scss">
  .list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .item {
    --padding-x: 16px;
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0 1rem;
    padding-block: 14px;
    padding-inline: var(--padding-x);
    isolation: isolate;
    background-color: var(--purple-bg);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease-out;

    &:hover,
    &:focus-within {
      background-color: var(--purple-bg-hover);

      .item-image-wrapper::before {
        opacity: 0;
      }
    }

    @media screen and (min-width: 48rem) {
      margin-left: calc(-1 * var(--padding-x));
      margin-right: calc(-1 * var(--padding-x));
    }
  }

  .item-image-wrapper {
    display: none;
    position: relative;
    flex-shrink: 0;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background-color: var(--purple);
      opacity: 0.7;
      transition: opacity 0.15s ease-out;
    }

    @media screen and (min-width: 24rem) {
      display: block;
    }
  }

  .item-icon {
    stroke-width: 1;
    flex-shrink: 0;
  }

  .item-info {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    flex-grow: 1;
  }

  .item-title {
    line-height: 1.2;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
    }
  }

  .item-details {
    opacity: 0.75;
    line-height: 1.4;
    display: flex;
    gap: 0.4rem;
  }
</style>
