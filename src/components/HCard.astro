---
import avatarImg from '../assets/sofie-avatar.jpg';

const { hideAvatar = false, asAuthor = true } = Astro.props;
---

<a class:list={['h-card u-url u-uid', { 'p-author': asAuthor }]} href="https://www.sofiepatoor.be">
  <span class="p-name">Sofie Patoor</span>
  <img src={avatarImg.src} alt="Sofie's avatar" width="24" height="24" class={hideAvatar ? 'vh' : ''}>
</a>

<style lang="scss">
  .h-card {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  span {
    text-transform: lowercase;
  }

  a {
    text-decoration: none;

    &:hover,
    &:focus {
      text-decoration: underline;
    }
  }
</style>