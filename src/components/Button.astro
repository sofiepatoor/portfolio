---
const { href, alignment } = Astro.props;
const isExternal = href.includes('http');
---

<a
  href={href}
  class={alignment}
  target={isExternal ? '_blank' : ''}
  rel={isExternal ? 'noopener' : ''}
>
  <slot />
  {isExternal && <span class="vh">(opens in new tab)</span>}
</a>

<style lang="scss">
  // TODO: fix transform flicker
  button,
  a {
    --depth: 6px;
    position: relative;
    display: flex;
    background-color: var(--purple);
    border-radius: 18px;
    width: fit-content;
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.3ch;
    text-transform: uppercase;
    text-decoration: none;
    padding: 10px 18px;
    cursor: pointer;
    transition: all 0.2s ease-in;
    will-change: transform;
    transform-style: preserve-3d;
    z-index: 1;

    &::before {
      content: "";
      position: absolute;
      left: 50%;
      bottom: calc(-1 * var(--depth));
      transform: translateZ(-1px) translateX(-50%);
      width: calc(100% + 2px); // make sure it aligns with edges of main element
      height: calc(100% + var(--depth));
      background-color: var(--purple-light);
      border: 3px solid var(--purple);
      border-radius: var(--radius-md);
      z-index: -1;
      transition: all 0.2s ease-in;
    }

    &:hover,
    &:focus {
      transform: translateY(var(--depth));
      background-color: var(--purple-hover);

      &::before {
        height: 100%;
        bottom: 0;
      }
    }
  }

  .center {
    margin: 0 auto;
  }
</style>